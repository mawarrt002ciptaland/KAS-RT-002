{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kas-rt-002",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-27",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "kas-rt-002"
    }
  ],
  "vars": {
    // DATABASE_URL dan AUTH_SECRET diset sebagai SECRET di dashboard Cloudflare
    // (Workers & Pages -> kas-rt-002 -> Settings -> Variables and Secrets)
  }
}
